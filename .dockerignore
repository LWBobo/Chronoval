# 依赖目录 (会在构建时重新安装)
node_modules
**/node_modules

# 数据目录：排除运行时 DB/日志，但保留 map_info 地名种子以便 COPY 进镜像
.data
data/*
!data/map_info/
!data/map_info/**

# 开发工具
.vscode
.idea

# 日志文件
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 环境变量文件
.env
.env.local
.env.development
.env.test
.env.production

# 缓存目录
.cache
.temp
.tmp
.nuxt

# 操作系统文件
.DS_Store
Thumbs.db

# Git 目录
.git

# 测试文件
coverage
__tests__
**/*.test.*
**/*.spec.*

# 开发配置
docker-compose.yml
docker-compose.yaml
.dockerignore

# 编辑器配置
.editorconfig

# 运行时绑定挂载，不进入镜像构建上下文
map_file
map_file/**

storage
storage/**

ml-cache
ml-cache/**

# 外部扫描库
data/library
data/library/**